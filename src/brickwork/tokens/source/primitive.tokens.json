      }
    },
    "control-gap": {
      "$description": "ADR-126 section 4: gap between a control's icon and label (or between its inner parts), by step. Computed as the md gap base (--bw-space-2, 0.5rem) times the step multiplier, so every step is distinct at every density: xs 0.375rem, sm 0.4375rem, md 0.5rem, lg 0.5625rem, xl 0.625rem at comfortable. Re-emitted inside every [data-density] block. Settles OQ-SZ-2.",
      "xs": {
        "$value": "calc(var(--bw-space-2) * var(--bw-size-step-xs))"
      },
      "sm": {
        "$value": "calc(var(--bw-space-2) * var(--bw-size-step-sm))"
      },
      "md": {
        "$value": "calc(var(--bw-space-2) * var(--bw-size-step-md))"
      },
      "lg": {
        "$value": "calc(var(--bw-space-2) * var(--bw-size-step-lg))"
      },
      "xl": {
        "$value": "calc(var(--bw-space-2) * var(--bw-size-step-xl))"
      }
    },
    "gap": {
      "$description": "ADR-126 section 6 / SIZE-COVERAGE gate 5: layout composition gap by step. md is --bw-density-stack-gap; other steps are that density base times the shared --bw-size-step-* multipliers, so every step is distinct at every density. At comfortable: xs 0.75rem, sm 0.875rem, md 1rem, lg 1.125rem, xl 1.25rem. Re-emitted inside every [data-density] block. Stack, cluster and grid read these via bw-<primitive>--gap-<step>.",
      "xs": {
        "$value": "calc(var(--bw-density-stack-gap) * var(--bw-size-step-xs))"
      },
      "sm": {
        "$value": "calc(var(--bw-density-stack-gap) * var(--bw-size-step-sm))"

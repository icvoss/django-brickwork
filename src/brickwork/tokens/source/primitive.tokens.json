      },
      "lg": {
        "$value": "max(1.5rem, calc(var(--bw-density-control-height) * var(--bw-size-step-lg)))"
      },
      "xl": {
        "$value": "max(1.5rem, calc(var(--bw-density-control-height) * var(--bw-size-step-xl)))"
      }
    },
    "control-padding-inline": {
      "$description": "ADR-125: density control padding base x step multiplier. Re-emitted inside every [data-density] block.",
      "xs": {
        "$value": "calc(var(--bw-density-control-padding-inline) * var(--bw-size-step-xs))"
      },
      "sm": {
        "$value": "calc(var(--bw-density-control-padding-inline) * var(--bw-size-step-sm))"
      },

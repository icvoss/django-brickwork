      }
    },
    "control-icon": {
      "$description": "ADR-126 section 4: icon box inside a control, by step. md is the base icon (the 1rem component icon); the other steps are that base times the shared step multiplier, so an icon follows its control's step (ADR-125 section 5). Density does not change it. Re-emitted inside every [data-density] block beside the other resolved control tokens.",
      "xs": {
        "$value": "calc(var(--bw-component-icon-size-sm) * var(--bw-size-step-xs))"
      },
      "sm": {
        "$value": "calc(var(--bw-component-icon-size-sm) * var(--bw-size-step-sm))"

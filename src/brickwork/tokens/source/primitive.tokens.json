    "control-height": {
      "$description": "ADR-125: computed, never authored per step. density control height x step multiplier, clamped to the 1.5rem WCAG 2.5.8 floor (md is the base and is not clamped). Re-emitted inside every [data-density] block so a density scoped to a subtree re-resolves the whole scale.",
      "xs": {
        "$value": "max(1.5rem, calc(var(--bw-density-control-height) * var(--bw-size-step-xs)))"
      },
      "sm": {
        "$value": "max(1.5rem, calc(var(--bw-density-control-height) * var(--bw-size-step-sm)))"
      },
      "md": {

{
  "$schema": "https://brickwork.icvoss.dev/token-manifest/v1",
  "version": 1,
  "description": "brickwork token contract: the load-bearing brand set and its constraints (brickwork#39), the full overridable --bw-* vocabulary, and derived-pair contrast constraints (brickwork#289, distinct from loadBearing: a contrastPairs entry holds between two DERIVED tokens that a brand does not directly author but can still break by overriding one of their inputs). Generated from the DTCG source; do not edit by hand.",
  "loadBearing": [
    {
      "name": "--bw-color-surface"
    },
    {
      "name": "--bw-color-surface-inverse",
      "conditional": true
    },
    {
      "name": "--bw-color-fg"
    },
    {
      "name": "--bw-color-fg-on-accent",
      "authoredPerTheme": true,
      "contrastPair": "--bw-color-accent",
      "minContrast": 4.5
    },
    {
      "name": "--bw-color-border"
    },
    {
      "name": "--bw-color-accent"
    },
    {
      "name": "--bw-color-danger"
    },
    {
      "name": "--bw-color-warning"
    },
    {
      "name": "--bw-color-success"
    },
    {
      "name": "--bw-color-info",
      "conditional": true,
      "collapsesTo": "--bw-color-accent"
    }
  ],
  "contrastPairs": [
    {
      "name": "--bw-color-danger-fg",
      "derived": "color-mix(in oklab, var(--bw-color-danger) 87%, var(--bw-color-status-fg-ink))",
      "contrastPair": "--bw-color-danger-subtle",
      "pairDerived": "color-mix(in oklab, var(--bw-color-danger) 7%, var(--bw-color-surface))",
      "minContrast": 4.5
    },
    {
      "name": "--bw-color-danger-fg",
      "derived": "color-mix(in oklab, var(--bw-color-danger) 87%, var(--bw-color-status-fg-ink))",
      "contrastPair": "--bw-color-surface",
      "pairDerived": "var(--bw-color-surface)",
      "minContrast": 4.5
    },
    {
      "name": "--bw-color-warning-fg",
      "derived": "color-mix(in oklab, var(--bw-color-warning) 68%, var(--bw-color-status-fg-ink))",
      "contrastPair": "--bw-color-warning-subtle",
      "pairDerived": "color-mix(in oklab, var(--bw-color-warning) 7%, var(--bw-color-surface))",
      "minContrast": 4.5
    },
    {
      "name": "--bw-color-warning-fg",
      "derived": "color-mix(in oklab, var(--bw-color-warning) 68%, var(--bw-color-status-fg-ink))",
      "contrastPair": "--bw-color-surface",
      "pairDerived": "var(--bw-color-surface)",
      "minContrast": 4.5
    },
    {
      "name": "--bw-color-success-fg",
      "derived": "color-mix(in oklab, var(--bw-color-success) 69%, var(--bw-color-status-fg-ink))",
      "contrastPair": "--bw-color-success-subtle",
      "pairDerived": "color-mix(in oklab, var(--bw-color-success) 7%, var(--bw-color-surface))",
      "minContrast": 4.5
    },
    {
      "name": "--bw-color-success-fg",
      "derived": "color-mix(in oklab, var(--bw-color-success) 69%, var(--bw-color-status-fg-ink))",
      "contrastPair": "--bw-color-surface",
      "pairDerived": "var(--bw-color-surface)",
      "minContrast": 4.5
    },
    {
      "name": "--bw-color-info-fg",
      "derived": "color-mix(in oklab, var(--bw-color-info) 75%, var(--bw-color-status-fg-ink))",
      "contrastPair": "--bw-color-info-subtle",
      "pairDerived": "color-mix(in oklab, var(--bw-color-info) 7%, var(--bw-color-surface))",
      "minContrast": 4.5
    },
    {
      "name": "--bw-color-info-fg",
